<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
<xacro:macro name="lrmate200id" params="prefix">

    <!-- property list -->
    <xacro:property name="j1_lower_limit" value="${radians(-180)}" />
    <xacro:property name="j2_lower_limit" value="${radians(-100)}" />
    <xacro:property name="j3_lower_limit" value="${radians(-70)}" />
    <xacro:property name="j4_lower_limit" value="${radians(-190)}" />
    <xacro:property name="j5_lower_limit" value="${radians(-125)}" />
    <xacro:property name="j6_lower_limit" value="${radians(-360)}" />

    <xacro:property name="j1_upper_limit" value="${radians(180)}" />
    <xacro:property name="j2_upper_limit" value="${radians(145)}" />
    <xacro:property name="j3_upper_limit" value="${radians(205)}" />
    <xacro:property name="j4_upper_limit" value="${radians(190)}" />
    <xacro:property name="j5_upper_limit" value="${radians(125)}" />
    <xacro:property name="j6_upper_limit" value="${radians(360)}" />

    <xacro:property name="j1_effort_limit" value="500" />
    <xacro:property name="j2_effort_limit" value="500" />
    <xacro:property name="j3_effort_limit" value="200" />
    <xacro:property name="j4_effort_limit" value="70" />
    <xacro:property name="j5_effort_limit" value="40" />
    <xacro:property name="j6_effort_limit" value="20" />

    <xacro:property name="j1_velocity_limit" value="${radians(450)}" />
    <xacro:property name="j2_velocity_limit" value="${radians(380)}" />
    <xacro:property name="j3_velocity_limit" value="${radians(520)}" />
    <xacro:property name="j4_velocity_limit" value="${radians(550)}" />
    <xacro:property name="j5_velocity_limit" value="${radians(545)}" />
    <xacro:property name="j6_velocity_limit" value="${radians(1000)}" />
    <!-- end of property list -->
    
    <!-- link list -->
    <!-- base_link -->
    <link name="${prefix}base_link">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://lrmate200id_support/meshes/lrmate200id/visual/base.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://lrmate200id_support/meshes/lrmate200id/collision/base.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value=" 5.3" />
        <origin xyz="-.0146 -.000342  .0796" />
        <inertia
          ixx=" .025"
          ixy="-.000574"
          ixz=" .000296"
          iyy=" .0305"
          iyz="-.000122"
          izz=" .0322"
        />
      </inertial>
    </link>
    
    <!-- link_1 -->
    <link name="${prefix}link_1">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://lrmate200id_support/meshes/lrmate200id/visual/j1.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://lrmate200id_support/meshes/lrmate200id/collision/j1.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value=" 5.62" />
        <origin xyz=" .0287  .000102 -.0547" />
        <inertia

          ixx=" .0417"
          ixy=" .0000238"

          ixz="-.00552"
          iyy=" .0303"
          iyz=" .000122"
          izz=" .0322"
        />
      </inertial>
    </link>
    
    <!-- link_2 -->
    <link name="${prefix}link_2">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://lrmate200id_support/meshes/lrmate200id/visual/j2.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://lrmate200id_support/meshes/lrmate200id/collision/j2.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value=" 9.05" />
        <origin xyz="-.00271 -.000976  .159" />
        <inertia
          ixx=" .159"
          ixy=" .0000335"
          ixz=" .000154"
          iyy=" .136"
          iyz="-.00108"
          izz=" .0429"
        />
      </inertial>
    </link>
    
    <!-- link_3 -->
    <link name="${prefix}link_3">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://lrmate200id_support/meshes/lrmate200id/visual/j3.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://lrmate200id_support/meshes/lrmate200id/collision/j3.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value=" 2.15" />
        <origin xyz=" .00887 -.0000626  .0171" />
        <inertia
          ixx=" .00585"
          ixy="-.000046"

          ixz="-.000622"
          iyy=" .00665"
          iyz="-.0000461"
          izz=" .00669"
        />
      </inertial>
    </link>
    
    <!-- link_4 -->
    <link name="${prefix}link_4">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://lrmate200id_support/meshes/lrmate200id/visual/j4.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://lrmate200id_support/meshes/lrmate200id/collision/j4.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value=" 2.42" />
        <origin xyz=" .223  .00356  .00215" />
        <inertia
          ixx=" .00395"
          ixy=" .000000261"
          ixz=" .0000725"
          iyy=" .0171"
          iyz="-.00000947"
          izz=" .0171"
        />
      </inertial>
    </link>
  
    <!-- link_5 -->
    <link name="${prefix}link_5">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://lrmate200id_support/meshes/lrmate200id/visual/j5.dae"
          />
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://lrmate200id_support/meshes/lrmate200id/collision/j5.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value=" .446" />
        <origin xyz=" .0177  .0025 -.00000419" />
        <inertia
          ixx=" .000339"
          ixy=" .0000187"
          ixz="-.0000000209"
          iyy=" .000601"
          iyz="-.0000000171"
          izz=" .000563"
        />
      </inertial>
    </link>
    
    <!-- link_6 -->
    <link name="${prefix}link_6">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://lrmate200id_support/meshes/lrmate200id/visual/j6.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://lrmate200id_support/meshes/lrmate200id/collision/j6.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value=" .0134" />
        <origin xyz=" .074  3.35E-18 -4.88E-19" />
        <inertia
          ixx=" .00000275"
          ixy=" 7.09E-21"
          ixz="-4.25E-22"
          iyy=" .00000153"
          iyz="-1.05E-22"
          izz=" .00000153"
        />
      </inertial>
    </link>
    
    <!-- tool0 -->
    <link name="${prefix}tool0"/>
    <!-- end of link list -->
    
    <!-- joint list -->
    <!-- joint_1 -->
    <joint name="${prefix}joint_1" type="revolute">
      <origin xyz=" 0  0  .33" rpy="0 0 0" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}link_1" />
      <axis xyz=" 0  0  1" />
      <limit
        lower="${j1_lower_limit}"
        upper="${j1_upper_limit}"
        effort="${j1_effort_limit}"
        velocity="${j1_velocity_limit}"
      />
    </joint>
    
    <!-- joint_2 -->
    <joint name="${prefix}joint_2" type="revolute">
      <origin xyz=" .05  0  0" rpy="0 0 0" />
      <parent link="${prefix}link_1" />
      <child link="${prefix}link_2" />
      <axis xyz=" 0  1  0" />
      <limit
        lower="${j2_lower_limit}"
        upper="${j2_upper_limit}"
        effort="${j2_effort_limit}"
        velocity="${j2_velocity_limit}"
      />
    </joint>
    
    <!-- joint_3 -->
    <joint name="${prefix}joint_3" type="revolute">
      <origin xyz=" 0  0  .33" rpy="0 0 0" />
      <parent link="${prefix}link_2" />
      <child link="${prefix}link_3" />
      <axis xyz=" 0 -1  0" />
      <limit
        lower="${j3_lower_limit}"
        upper="${j3_upper_limit}"
        effort="${j3_effort_limit}"
        velocity="${j3_velocity_limit}"
      />
    </joint>
    
    <!-- joint_4 -->
    <joint name="${prefix}joint_4" type="revolute">
      <origin xyz=" 0  0  .035" rpy="0 0 0" />
      <parent link="${prefix}link_3" />
      <child link="${prefix}link_4" />
      <axis xyz="-1  0  0" />
      <limit
        lower="${j4_lower_limit}"
        upper="${j4_upper_limit}"
        effort="${j4_effort_limit}"
        velocity="${j4_velocity_limit}"
      />
    </joint>

    <!-- joint_5 -->
    <joint name="${prefix}joint_5" type="revolute">
      <origin xyz=" .335  0  0" rpy="0 0 0" />
      <parent link="${prefix}link_4" />
      <child link="${prefix}link_5" />
      <axis xyz=" 0 -1  0" />
      <limit
        lower="${j5_lower_limit}"
        upper="${j5_upper_limit}"
        effort="${j5_effort_limit}"
        velocity="${j5_velocity_limit}"
      />
    </joint>
    
    <!-- joint_6 -->
    <joint name="${prefix}joint_6" type="revolute">
      <origin xyz=" 0  0  0" rpy="0 0 0" />
      <parent link="${prefix}link_5" />
      <child link="${prefix}link_6" />
      <axis xyz="-1  0  0" />
      <limit
        lower="${j6_lower_limit}"
        upper="${j6_upper_limit}"
        effort="${j6_effort_limit}"
        velocity="${j6_velocity_limit}"
      />
    </joint>
    
    <!-- joint_6-tool0 -->
    <joint name="${prefix}joint_6-tool0" type="fixed">
      <!-- tool0 = flange face (0.08 m from the wrist centre), z axis pointing out of the flange (ROS-Industrial convention) -->
      <origin xyz="0.08 0 0" rpy="${pi} ${-pi/2} 0" />
      <parent link="${prefix}link_6" />
      <child link="${prefix}tool0" />
    </joint>
    <!-- end of joint list -->

    <!-- ROS base_link to ABB World Coordinates transform -->
    <link name="${prefix}base" />
    <joint name="${prefix}base_link-base" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="${prefix}base_link"/>
        <child link="${prefix}base"/>
    </joint>
</xacro:macro>
</robot>
